# Copie para .env e preencha. O .env NÃO vai para o git.
# As chaves de MODELO podem ficar no .env do funil — este arquivo lê os dois.

# ── Imagem (opcional, mas é o que tira o vídeo do preto puro) ────────
# Basta UMA. Todas grátis, todas com licença de uso comercial.
# Nenhuma raspagem: o Pinterest é mural de imagem de terceiro, e usar
# aquilo em vídeo monetizado é o que derruba conta depois que ela já
# está faturando.

# pexels.com/api/new — 200 buscas por hora
PEXELS_API_KEY=

# pixabay.com/api/docs — 100 por minuto
PIXABAY_API_KEY=

# unsplash.com/developers — 50 por hora no modo demo
UNSPLASH_ACCESS_KEY=
