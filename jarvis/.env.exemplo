# Copie este arquivo para .env e preencha. O .env NÃO vai para o git.

# OBRIGATÓRIA — é o cérebro do Jarvis.
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Opcionais. Sem elas, o Jarvis funciona; só não consegue
# "pergunta pro ChatGPT" e "o que o Gemini acha disso".
OPENAI_API_KEY=
GEMINI_API_KEY=
