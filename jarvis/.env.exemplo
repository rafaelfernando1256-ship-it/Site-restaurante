# Copie este arquivo para .env e preencha. O .env NÃO vai para o git.

# ── O CÉREBRO: preencha UMA delas ───────────────────────────────────
# Quem você preencher vira quem decide e usa as ferramentas. Se preencher
# mais de uma, escolha em config.toml → provedor.
# As que sobrarem continuam servindo de consultor ("o que o Gemini acha?").

# console.anthropic.com → API Keys  (começa com sk-ant-api03-)
# Atenção: o token do claude.ai (sk-ant-usr-) NÃO serve aqui.
ANTHROPIC_API_KEY=

# aistudio.google.com/apikey
# Serve nos dois formatos que o Google emite: começando com AQ. (novo)
# ou com AIza (antigo). Cole inteira, sem aspas.
GEMINI_API_KEY=

# openrouter.ai/keys  (sk-or-v1-...)
# Uma chave alcança Claude, GPT, Gemini e os modelos abertos.
OPENROUTER_API_KEY=

# console.groq.com/keys  (gsk_...)
# Grátis sem cartão, e o mais rápido dos quatro. Duas ressalvas:
#   • 30 requisições por minuto no plano grátis, e cada volta de
#     ferramenta gasta uma. Tarefa longa esbarra nisso.
#   • o catálogo é de modelos abertos; a escolha automática prefere os
#     que sabem chamar ferramenta, porque os outros só conversam.
GROQ_API_KEY=

# ── opcional ────────────────────────────────────────────────────────
# Só para "pergunta pro ChatGPT".
OPENAI_API_KEY=
