# Copie este arquivo para .env e preencha. O .env NÃO vai para o git.

# ── O CÉREBRO: preencha UMA das duas ────────────────────────────────
# Quem você preencher vira quem decide e usa as ferramentas. Se preencher
# as duas, escolha em config.toml → provedor = "claude" ou "gemini".
# A que sobrar continua servindo de consultor ("o que o Gemini acha?").

# console.anthropic.com → API Keys  (começa com sk-ant-api03-)
# Atenção: o token do claude.ai (sk-ant-usr-) NÃO serve aqui.
ANTHROPIC_API_KEY=

# aistudio.google.com/apikey  (começa com AIza)
GEMINI_API_KEY=

# ── opcional ────────────────────────────────────────────────────────
# Só para "pergunta pro ChatGPT".
OPENAI_API_KEY=
