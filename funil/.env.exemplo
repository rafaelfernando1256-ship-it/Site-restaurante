# Copie para .env e preencha. O .env NÃO vai para o git.

# Agente 1 — Google Places API (New).
# console.cloud.google.com → ative "Places API (New)" → Credenciais → chave.
# Restrinja a chave a esta API; chave aberta é fatura aberta.
GOOGLE_PLACES_KEY=

# Agentes 2, 3 e 4 — o cérebro. Preencha UMA delas.
# Quem você preencher vira quem escreve as abordagens, tria as respostas
# e lê o Instagram. Com mais de uma, escolha em config.toml → provedor.

# console.anthropic.com → API Keys  (sk-ant-api03-...)
ANTHROPIC_API_KEY=

# aistudio.google.com/apikey  (AQ.... ou AIza...)
GEMINI_API_KEY=

# openrouter.ai/keys  (sk-or-...) — uma chave alcança Claude, GPT e Gemini
OPENROUTER_API_KEY=

# console.groq.com/keys  (gsk_...) — grátis de verdade, sem cartão, e o
# mais rápido dos quatro. Duas ressalvas que importam para este funil:
#   • 30 requisições por minuto e 1.000 por dia no plano grátis. O funil
#     trata o 429 como passageiro e espera, mas um lote grande demora.
#   • só a família Llama 4 lê imagem. Para o agente 3 ler o Instagram,
#     ele troca de modelo sozinho; se a sua chave não tiver nenhum com
#     olhos, use o Gemini nesse passo.
GROQ_API_KEY=

# Agente 4 — Netlify.
# app.netlify.com/user/applications → Personal access tokens
NETLIFY_TOKEN=

# Opcional, e desligado por padrão: envio automático pela Cloud API
# oficial do WhatsApp. Exige conta Business verificada e, no primeiro
# contato, template aprovado. Leia o topo de nucleo/a2_abordagem.py
# antes de preencher isto.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
