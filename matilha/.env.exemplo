# Você NÃO precisa editar este arquivo.
#
# O INSTALAR.mjs copia ele para .env sozinho, e as chaves você cola no
# painel: aba Ajustes -> Chaves. A Matilha escreve aqui por você.
#
# Isto aqui é só o molde, e a referência de onde pegar cada chave.
# O .env fica SÓ no seu notebook.

# Quem escreve as mensagens e o texto dos sites. Grátis.
# console.groq.com/keys
GROQ_API_KEY=

# Quem publica os sites. app.netlify.com -> User settings ->
# Applications -> Personal access tokens
NETLIFY_TOKEN=

# O caçador. console.cloud.google.com -> ative "Places API (New)"
# -> Credenciais -> Chave de API. Opcional: sem ela você põe
# cliente à mão.
GOOGLE_PLACES_KEY=

# Opcional: outro modelo do Groq.
# GROQ_MODELO=openai/gpt-oss-120b

# Opcional: senha a mais no painel. Local, o servidor já só escuta
# em 127.0.0.1 — isto é uma segunda tranca, não a única.
# PAINEL_SENHA=
